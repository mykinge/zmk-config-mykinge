#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                // Matriz 2x4 (9 switches) - Posiciones 0-8
                &kp N1  &kp N2  &kp N3 &kp N4   // Row1: Col1, Col2, Col3
                &kp N5  &kp N6  &kp N7 &kp N8  // Row2: Col1, Col2, Col3
            >;
        };
    };
};