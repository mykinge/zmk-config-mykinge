#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                // Matriz 3x3 (9 switches)
                &kp N1  &kp N2  &kp N3    // Fila 1
                &kp N4  &kp N5  &kp N6    // Fila 2
                &kp N7  &kp N8  &kp N9    // Fila 3
                
                // GPIO Directo
                &kp A   // Leva 1 (shift down)
                &kp B   // Leva 2 (shift up)
                &kp C   // Alps 1
                &kp D   // Alps 2
                &kp E   // Alps 3
            >;
        };
    };
};