#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    combos {
        compatible = "zmk,combos";
        
        combo_bt_clear {
            timeout-ms = <50>;
            key-positions = <0 7>;  // Posiciones 0 (Numpad1) y 7 (Numpad8)
            bindings = <&bt BT_CLR>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                // Matriz 2x4 (8 botones) - Numpad
                &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_N4
                &kp KP_N5  &kp KP_N6  &kp KP_N7  &kp KP_N8
                
                // GPIO Directo (13 pines)
                &kp Q            // P1.00 - Switch del encoder
                &kp N1           // P0.02
                &kp N2           // P0.09
                &kp N3           // P0.10
                &kp KP_N0        // P0.29 - LEVA 1 (Shift Down)
                &kp KP_N9        // P0.31 - LEVA 2 (Shift Up)
                &kp N4           // P1.01
                &kp N5           // P1.02
                &kp N6           // P1.06
                &kp N7           // P1.07
                &kp N8           // P1.08
                &kp N9           // P1.13
                &kp N0           // P1.15
            >;
            
            // Encoder: giro derecha = Z, giro izquierda = A
            sensor-bindings = <&inc_dec_kp Z A>;
        };
    };
};