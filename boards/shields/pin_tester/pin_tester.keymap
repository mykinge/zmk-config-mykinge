#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                // Matriz 2x4 (8 botones) - Numpad
                &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_N4
                &kp KP_N5  &kp KP_N6  &kp KP_N7  &kp KP_N8
                
                // GPIO Directo (15 pines)
                &kp KP_N9        // P0.02
                &kp KP_N0        // P0.11
                &kp KP_PLUS      // P0.09
                &kp KP_MINUS     // P0.10
                &kp KP_MULTIPLY  // P0.29
                &kp KP_DIVIDE    // P0.31
                &kp KP_DOT       // P1.00
                &kp KP_ENTER     // P1.01
                &kp F1           // P1.02
                &kp F2           // P1.04
                &kp F3           // P1.06
                &kp F4           // P1.07
                &kp F5           // P1.11
                &kp F6           // P1.13
                &kp F7           // P1.15
            >;
        };
    };
};