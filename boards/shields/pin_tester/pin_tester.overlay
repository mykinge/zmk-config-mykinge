/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        rows = <3>;
        columns = <3>;
        map = <
            RC(0,0) RC(0,1) RC(0,2)
            RC(1,0) RC(1,1) RC(1,2)
            RC(2,0) RC(2,1) RC(2,2)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN_3x3";
        wakeup-source;

        // Diodos: columna -> fila (col2row)
        diode-direction = "col2row";

        // Columnas: las activas una a una (salida)
        col-gpios =
            <&pro_micro 13 GPIO_ACTIVE_HIGH>,  // Col 0
            <&pro_micro 14 GPIO_ACTIVE_HIGH>,  // Col 1
            <&pro_micro 15 GPIO_ACTIVE_HIGH>;  // Col 2

        // Filas: entradas con pull-down, activas en HIGH tras el diodo
        row-gpios =
            <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  // Row 0
            <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  // Row 1
            <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;  // Row 2
    };
};
