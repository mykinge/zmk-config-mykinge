/ {
    chosen {
        zmk,kscan = &kscan0;
    };

    kscan0: kscan_matrix {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        
        diode-direction = "col2row";
        
        row-gpios
            = <&gpio0 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // Fila 1
            , <&gpio0 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // Fila 2
            ;
        
        col-gpios
            = <&gpio0 17 GPIO_ACTIVE_HIGH>  // Columna 1
            , <&gpio0 20 GPIO_ACTIVE_HIGH>  // Columna 2
            , <&gpio0 22 GPIO_ACTIVE_HIGH>  // Columna 3
            , <&gpio0 24 GPIO_ACTIVE_HIGH>  // Columna 4
            ;
    };
};