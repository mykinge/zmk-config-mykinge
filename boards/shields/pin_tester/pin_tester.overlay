/ {
    chosen {
        zmk,kscan = &kscan0;
    };

    kscan0: kscan_composite {
        compatible = "zmk,kscan-composite";
        label = "KSCAN";
        rows = <3>;
        columns = <4>;

        // Matriz 2x4 primero
        matrix {
            kscan = <&kscan1>;
        };

        // GPIO directo desplazado
        direct {
            kscan = <&kscan2>;
            row-offset = <2>;
        };
    };

    kscan1: kscan_matrix {
        compatible = "zmk,kscan-gpio-matrix";
        label = "MATRIX";
        wakeup-source;
        
        diode-direction = "col2row";
        
        row-gpios
            = <&gpio0 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // Fila 1
            , <&gpio0 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // Fila 2
            ;
        
        col-gpios
            = <&gpio0 17 GPIO_ACTIVE_HIGH>  // Columna 1
            , <&gpio0 20 GPIO_ACTIVE_HIGH>  // Columna 2
            , <&gpio0 22 GPIO_ACTIVE_HIGH>  // Columna 3
            , <&gpio0 24 GPIO_ACTIVE_HIGH>  // Columna 4
            ;
    };

    kscan2: kscan_direct {
        compatible = "zmk,kscan-gpio-direct";
        label = "DIRECT";
        wakeup-source;

        input-gpios
            = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>    // P0.02
            , <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // P0.11
            , <&gpio0 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>    // P0.09
            , <&gpio0 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // P0.10
            , <&gpio0 29 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // P0.29
            , <&gpio0 31 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // P0.31
            , <&gpio1 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>    // P1.00
            , <&gpio1 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>    // P1.01
            , <&gpio1 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>    // P1.02
            , <&gpio1 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>    // P1.04
            , <&gpio1 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>    // P1.06
            , <&gpio1 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>    // P1.07
            , <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // P1.11
            , <&gpio1 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // P1.13
            , <&gpio1 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // P1.15
            ;
    };
};