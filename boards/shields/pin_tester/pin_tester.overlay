/ {
    chosen {
        zmk,kscan = &kscan0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;

        input-gpios
            = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // P0.02
            , <&gpio0 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // P0.03
            , <&gpio0 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // P0.04
            , <&gpio0 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // P0.05
            , <&gpio0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // P0.06
            , <&gpio0 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // P0.07
            , <&gpio0 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // P0.08
            , <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // P0.11
            , <&gpio0 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // P0.12
            , <&gpio0 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // P0.15
            , <&gpio0 16 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // P0.16
            , <&gpio0 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // P0.17
            , <&gpio0 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // P0.20
            , <&gpio0 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // P0.22
            , <&gpio0 26 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // P0.26
            , <&gpio0 29 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // P0.29
            , <&gpio0 30 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // P0.30
            , <&gpio0 31 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // P0.31
            , <&gpio1 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // P1.01
            , <&gpio1 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // P1.02
            , <&gpio1 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // P1.03
            , <&gpio1 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // P1.04
            , <&gpio1 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // P1.05
            , <&gpio1 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // P1.06
            , <&gpio1 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // P1.07
            , <&gpio1 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // P1.09
            , <&gpio1 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // P1.10
            , <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // P1.11
            , <&gpio1 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // P1.13
            , <&gpio1 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // P1.15
            ;
    };
};