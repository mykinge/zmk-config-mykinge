{
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform-state";
        rows = <3>;
        cols = <3>;
        map = <
            0 0 0 1 0 2
            1 0 1 1 1 2
            2 0 2 1 2 2
        >;
    };

    kscan0: kscan_gpio_matrix {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN_3x3";
        diode-direction = "col2row";
        col-gpios =
            <&pro_micro 13>,
            <&pro_micro 14>,
            <&pro_micro 15>;
        row-gpios =
            <&pro_micro 5>,
            <&pro_micro 7>,
            <&pro_micro 8>;
    };
};

